# ---------------------------------------------------------------------------
# SEO Page Checker — environment configuration
#
# Copy this file to `.env` and fill in what you need:
#     cp .env.example .env
#
# EVERY VALUE HAS A SAFE DEFAULT. The app runs with an empty .env — it just
# stores reports in memory instead of a database. Nothing here is secret except
# DATABASE_URL and CONTACT_WEBHOOK_URL, and neither belongs in version control.
# ---------------------------------------------------------------------------


# --- Database --------------------------------------------------------------
# PostgreSQL connection string. Reports are stored here.
#
# LEAVE IT UNSET for local development: the app falls back to an in-memory
# store so you can run it immediately. That store is lost on restart and is not
# shared between server processes, so it is NOT suitable for production.
#
# Neon:     postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# Local:    postgresql://postgres:postgres@localhost:5432/seo_page_checker
DATABASE_URL=


# --- Public URL ------------------------------------------------------------
# The origin this site is served from. Used for canonical URLs, the sitemap,
# social card metadata, and the link in the crawler's User-Agent.
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://yourdomain.com
APP_URL=https://yourdomain.com


# --- Branding --------------------------------------------------------------
# Change the product name in one place. Leave unset to use "SEO Page Checker".
NEXT_PUBLIC_BRAND_NAME=

# Shown on the contact page. Leave unset and the page says so honestly rather
# than printing a fake address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Twitter/X handle for social cards, including the @. Optional.
NEXT_PUBLIC_TWITTER_HANDLE=


# --- Contact form ----------------------------------------------------------
# Where contact messages are delivered. Any endpoint that accepts a JSON POST:
# a Slack or Discord incoming webhook, Zapier, Formspree, or your own service.
# Unset means the contact form tells visitors it is not connected, rather than
# accepting messages and silently dropping them.
CONTACT_WEBHOOK_URL=


# --- Crawler ---------------------------------------------------------------
# How we identify ourselves to the sites we fetch. Keep a contact URL in it so
# site owners can find out what we are. Never impersonate Googlebot.
# Default: SEOPageCheckerBot/1.0 (+${APP_URL}/about#bot)
CRAWLER_USER_AGENT=

# Largest response body we will read, in bytes. Default: 5242880 (5 MB).
MAX_CRAWL_SIZE=5242880

# Total time budget for one audit's page fetch, in milliseconds. Default: 10000.
CRAWL_TIMEOUT=10000

# Maximum redirect hops to follow. Default: 10.
MAX_REDIRECTS=10


# --- Rate limiting ---------------------------------------------------------
# Audits allowed per client per window. Default: 5.
RATE_LIMIT_MAX=5

# The window, in milliseconds. Default: 3600000 (1 hour).
RATE_LIMIT_WINDOW=3600000


# --- Data retention --------------------------------------------------------
# How many days a stored report survives before deletion. Default: 7.
AUDIT_RETENTION_DAYS=7


# --- Danger zone -----------------------------------------------------------
# Allows the crawler to reach loopback and private addresses. This DISABLES
# SSRF protection and must stay false anywhere reachable from the internet.
# Only turn it on to test this tool against a site on your own machine.
ALLOW_PRIVATE_NETWORK_TARGETS=false


# --- Google PageSpeed Insights (optional) -----------------------------------
# Enables the live page-speed panel on reports: Core Web Vitals from real
# Chrome users, plus Lighthouse lab results and Google's own suggestions.
#
# Get one free: console.cloud.google.com -> enable "PageSpeed Insights API"
# -> Credentials -> Create API key. The free quota is 25,000 requests/day.
#
# Leave it unset and the panel honestly says speed testing is not enabled,
# rather than showing anything invented. Nothing else is affected.
PAGESPEED_API_KEY=
